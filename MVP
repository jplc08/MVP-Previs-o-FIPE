    "## 3. Limpeza e preparação\n\nOperações aplicadas, com justificativa:\n\n| Operação | Por quê |\n|---|---|\n| Conversão de `Valor FIPE` texto → numérico | Planilhas brasileiras trazem `R$ 12.345,67` como string |\n| Normalização de texto (maiúsculas, acentos, espaços) | `\"FIAT\"`, `\"Fiat \"` e `\"FIAT\"` viram a mesma categoria |\n| Remoção de alvo nulo / ≤ 0 | Sem alvo válido não há aprendizado supervisionado |\n| Filtro de `Ano Modelo` plausível | Corrige erros de digitação (ex.: `32000`, `19`) |\n| Remoção de outliers extremos do alvo | Valores absurdos distorcem MAE/RMSE e o ajuste linear |\n| Agrupamento de categorias raras em `OUTROS` | Evita colunas one-hot presentes só no treino |\n| **Remoção de linhas 100% duplicadas** | Registros repetidos inflam artificialmente o desempenho |"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "ANO_ATUAL = dt.date.today().year\n\ndef para_numero(serie):\n    '''Converte 'R$ 12.345,67' / '12.345,67' / 12345.67 em float.'''\n    if pd.api.types.is_numeric_dtype(serie):\n        return pd.to_numeric(serie, errors=\"coerce\")\n    s = (serie.astype(str)\n              .str.replace(r\"[Rr]\\$\", \"\", regex=True)\n              .str.replace(r\"\\s|\\u00a0\", \"\", regex=True)\n              .str.replace(\".\", \"\", regex=False)\n              .str.replace(\",\", \".\", regex=False))\n    return pd.to_numeric(s, errors=\"coerce\")\n\ndef normalizar_texto(serie):\n    s = serie.astype(str).str.strip().str.upper()\n    s = s.apply(lambda x: unicodedata.normalize(\"NFKD\", x).encode(\"ascii\", \"ignore\").decode())\n    s = s.str.replace(r\"\\s+\", \" \", regex=True)\n    return s.replace({\"NAN\": np.nan, \"\": np.nan, \"NONE\": np.nan, \"-\": np.nan})\n\nALVO = \"valor_fipe\"\nCATEGORICAS = [c for c in [\"montadora\", \"modelo\", \"cor\", \"grupo\", \"situacao\"] if c in df.columns]\nNUMERICAS   = [c for c in [\"ano_modelo\"] if c in df.columns]\n\nd = df.copy()\nregistro_limpeza = [(\"bruto\", len(d))]\n\nd[ALVO] = para_numero(d[ALVO])\nfor c in CATEGORICAS:\n    d[c] = normalizar_texto(d[c])\nif \"ano_modelo\" in d.columns:\n    d[\"ano_modelo\"] = pd.to_numeric(d[\"ano_modelo\"], errors=\"coerce\")\n\nd = d.dropna(subset=[ALVO]); registro_limpeza.append((\"alvo não nulo\", len(d)))\nd = d[d[ALVO] > 0];          registro_limpeza.append((\"alvo > 0\", len(d)))\n\nif \"ano_modelo\" in d.columns:\n    d = d[d[\"ano_modelo\"].between(1985, ANO_ATUAL + 1)]\n    registro_limpeza.append((f\"ano entre 1985 e {ANO_ATUAL+1}\", len(d)))\n\n# Outliers do alvo: limite generoso (3*IQR) — remove erro de cadastro, preserva veículo caro real\nq1, q3 = d[ALVO].quantile([.25, .75])\niqr = q3 - q1\nlim_inf, lim_sup = max(q1 - 3 * iqr, 0), q3 + 3 * iqr\nn_out = ((d[ALVO] < lim_inf) | (d[ALVO] > lim_sup)).sum()\nd = d[d[ALVO].between(lim_inf, lim_sup)]\nregistro_limpeza.append((f\"sem outliers (3xIQR): R$ {lim_inf:,.0f} a R$ {lim_sup:,.0f}\", len(d)))\n\nn_dup = d.duplicated().sum()\nd = d.drop_duplicates(); registro_limpeza.append((\"sem linhas 100% duplicadas\", len(d)))\n\nfor c in CATEGORICAS:\n    freq = d[c].value_counts()\n    raras = freq[freq < 2].index\n    d[c] = d[c].where(~d[c].isin(raras), \"OUTROS\").fillna(\"NAO_INFORMADO\")\n\nprint(f\"Outliers removidos: {n_out} | Linhas duplicadas removidas: {n_dup}\\n\")\ndisplay(pd.DataFrame(registro_limpeza, columns=[\"etapa\", \"linhas_restantes\"]))\nprint(f\"\\nDataset final: {len(d):,} veículos\")"
