    "fig, ax = plt.subplots(2, 2, figsize=(14, 9))\n\nsns.histplot(d[ALVO], bins=40, kde=True, ax=ax[0, 0], color=\"#2b6cb0\")\nax[0, 0].set_title(\"Distribuição do Valor FIPE (R$)\")\nax[0, 0].set_xlabel(\"Valor FIPE\")\n\nsns.histplot(np.log1p(d[ALVO]), bins=40, kde=True, ax=ax[0, 1], color=\"#2f855a\")\nax[0, 1].set_title(\"Distribuição de log(1 + Valor FIPE)\")\nax[0, 1].set_xlabel(\"log(1+Valor)\")\n\nif \"ano_modelo\" in d.columns:\n    sns.scatterplot(data=d, x=\"ano_modelo\", y=ALVO, alpha=.35, ax=ax[1, 0], color=\"#c05621\")\n    ax[1, 0].set_title(\"Valor FIPE x Ano Modelo\")\n\nif \"montadora\" in d.columns:\n    top = d[\"montadora\"].value_counts().head(10).index\n    sns.boxplot(data=d[d[\"montadora\"].isin(top)], y=\"montadora\", x=ALVO,\n                ax=ax[1, 1], order=top, palette=\"crest\")\n    ax[1, 1].set_title(\"Valor FIPE por montadora (top 10 em volume)\")\n\nplt.tight_layout(); plt.show()\n\nassimetria = d[ALVO].skew()\nprint(f\"Assimetria (skewness) do alvo: {assimetria:.2f}\")\nprint(\"-> Assimetria > 1 justifica modelar log(valor): erro proporcional ao preço, \"\n      \"resíduos mais homocedásticos e melhor ajuste dos modelos lineares.\")"
