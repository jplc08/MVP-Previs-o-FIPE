    "# Poder explicativo de cada categórica: variância do alvo explicada pelos grupos (eta²)\ndef eta_quadrado(dados, cat, alvo):\n    grupos = dados.groupby(cat)[alvo]\n    ss_entre = ((grupos.mean() - dados[alvo].mean()) ** 2 * grupos.count()).sum()\n    ss_total = ((dados[alvo] - dados[alvo].mean()) ** 2).sum()\n    return ss_entre / ss_total if ss_total else np.nan\n\nlinhas = [{\"variavel\": c, \"n_categorias\": d[c].nunique(),\n           \"eta2 (var. explicada)\": round(eta_quadrado(d, c, ALVO), 3)} for c in CATEGORICAS]\nif \"ano_modelo\" in d.columns:\n    linhas.append({\"variavel\": \"ano_modelo (corr. Pearson)\", \"n_categorias\": d[\"ano_modelo\"].nunique(),\n                   \"eta2 (var. explicada)\": round(d[\"ano_modelo\"].corr(d[ALVO]) ** 2, 3)})\n\ndisplay(pd.DataFrame(linhas).sort_values(\"eta2 (var. explicada)\", ascending=False))\nprint(\"Atenção: eta² alto em variável de altíssima cardinalidade (ex.: 'modelo') NÃO significa \"\n      \"poder preditivo — significa memorização. É por isso que validamos por grupo.\")"
   ]
