    "# Padroniza nomes de colunas e localiza automaticamente as colunas de interesse\ndef _slug(s):\n    s = str(s).strip()\n    s = unicodedata.normalize(\"NFKD\", s).encode(\"ascii\", \"ignore\").decode()\n    s = re.sub(r\"[^0-9a-zA-Z]+\", \"_\", s).strip(\"_\").lower()\n    return s\n\ndf = df_raw.copy()\ndf.columns = [_slug(c) for c in df.columns]\n\nMAPA = {\n    \"valor_fipe\":  [\"valor_fipe\", \"vlr_fipe\", \"valor\", \"preco_fipe\", \"fipe\", \"valor_tabela_fipe\"],\n    \"montadora\":   [\"montadora\", \"marca\", \"fabricante\"],\n    \"modelo\":      [\"modelo\", \"descricao_modelo\", \"veiculo\", \"modelo_versao\"],\n    \"cor\":         [\"cor\", \"cor_veiculo\"],\n    \"grupo\":       [\"grupo\", \"categoria\", \"tipo\", \"segmento\"],\n    \"situacao\":    [\"situacao\", \"status\", \"condicao\"],\n    \"ano_modelo\":  [\"ano_modelo\", \"anomodelo\", \"ano_mod\", \"ano\"],\n}\n\nresolvido, faltando = {}, []\nfor alvo, candidatos in MAPA.items():\n    achou = next((c for c in candidatos if c in df.columns), None)\n    if achou:\n        resolvido[achou] = alvo\n    else:\n        faltando.append(alvo)\n\ndf = df.rename(columns=resolvido)\nprint(\"Colunas mapeadas :\", resolvido)\nprint(\"Não encontradas  :\", faltando if faltando else \"nenhuma\")\nprint(\"\\nTodas as colunas do arquivo:\")\nprint(list(df.columns))"
