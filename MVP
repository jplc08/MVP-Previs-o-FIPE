    "X = d[CAT_FINAL + NUM_FINAL].copy()\ny = d[ALVO].copy()\ngrupos = d[\"_grupo_veiculo\"].copy()\n\ngss = GroupShuffleSplit(n_splits=1, test_size=0.2, random_state=RANDOM_STATE)\nidx_tr, idx_te = next(gss.split(X, y, groups=grupos))\nX_tr, X_te = X.iloc[idx_tr], X.iloc[idx_te]\ny_tr, y_te = y.iloc[idx_tr], y.iloc[idx_te]\ng_tr = grupos.iloc[idx_tr]\n\nprint(f\"Treino: {len(X_tr):,} registros | {g_tr.nunique():,} veículos distintos\")\nprint(f\"Teste : {len(X_te):,} registros | {grupos.iloc[idx_te].nunique():,} veículos distintos\")\nprint(f\"Interseção de veículos entre treino e teste: \"\n      f\"{len(set(g_tr) & set(grupos.iloc[idx_te]))} (deve ser 0)\")"
