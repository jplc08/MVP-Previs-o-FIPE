    "# Calibra o intervalo com os resíduos fora-da-amostra do melhor modelo (escala log)\noof_melhor = oof_por_modelo[MELHOR]\nres_log = np.log1p(y_tr.values) - np.log1p(np.maximum(oof_melhor, 0))\nq05, q95 = np.quantile(res_log, [0.05, 0.95])\nCOBERTURA = 90\n\nMARCAS_COMUNS  = set(d[\"montadora\"].value_counts()[lambda s: s >= 5].index) if \"montadora\" in d else set()\nFAMILIAS_COMUNS = set(d[\"familia\"].value_counts()[lambda s: s >= 5].index) if \"familia\" in d else set()\n\ndef avaliar_veiculo(montadora=None, familia=None, ano_modelo=None, cor=None,\n                    grupo=None, situacao=None, preco_ofertado=None, verbose=True):\n    '''Estima o Valor FIPE, o intervalo de confiança e recomenda uma ação sobre a oferta.'''\n    reg = {}\n    if \"montadora\" in CAT_FINAL: reg[\"montadora\"] = (montadora or \"NAO_INFORMADO\").upper()\n    if \"familia\"   in CAT_FINAL: reg[\"familia\"]   = (familia   or \"NAO_INFORMADO\").upper()\n    if \"cor\"       in CAT_FINAL: reg[\"cor\"]       = (cor       or \"NAO_INFORMADO\").upper()\n    if \"grupo\"     in CAT_FINAL: reg[\"grupo\"]     = (grupo     or \"NAO_INFORMADO\").upper()\n    if \"situacao\"  in CAT_FINAL: reg[\"situacao\"]  = (situacao  or \"NAO_INFORMADO\").upper()\n    if \"idade\" in NUM_FINAL:\n        reg[\"idade\"] = ANO_ATUAL - ano_modelo if ano_modelo else np.nan\n    if \"motor\" in NUM_FINAL:\n        reg[\"motor\"] = np.nan\n        reg[\"tem_motor_informado\"] = 0\n\n    entrada = pd.DataFrame([reg])[CAT_FINAL + NUM_FINAL]\n    log_pred = modelo_final.predict(entrada)[0]\n\n    estimado = float(np.expm1(log_pred))\n    piso     = float(np.expm1(log_pred + q05))\n    teto     = float(np.expm1(log_pred + q95))\n\n    alertas = []\n    if \"montadora\" in reg and reg[\"montadora\"] not in MARCAS_COMUNS:\n        alertas.append(\"montadora pouco representada na base\")\n    if \"familia\" in reg and reg[\"familia\"] not in FAMILIAS_COMUNS:\n        alertas.append(\"família de modelo pouco representada na base\")\n    if ano_modelo and not (1985 <= ano_modelo <= ANO_ATUAL + 1):\n        alertas.append(\"ano-modelo fora da faixa de treino\")\n\n    decisao, justificativa = None, None\n    if preco_ofertado is not None:\n        desvio = (preco_ofertado - estimado) / estimado * 100\n        if preco_ofertado < piso:\n            decisao = \"COMPRAR — oferta abaixo da faixa esperada\"\n        elif preco_ofertado > teto:\n            decisao = \"RECUSAR / RENEGOCIAR — oferta acima da faixa esperada\"\n        else:\n            decisao = \"NEGOCIAR — oferta dentro da faixa esperada\"\n        justificativa = f\"desvio de {desvio:+.1f}% em relação ao valor estimado\"\n\n    if verbose:\n        print(\"=\" * 62)\n        print(\"  AVALIAÇÃO DE VEÍCULO — Suporte à Decisão\")\n        print(\"=\" * 62)\n        print(f\"  {montadora or '?'} {familia or ''} | ano-modelo {ano_modelo or '?'}\")\n        print(\"-\" * 62)\n        print(f\"  Valor estimado          : R$ {estimado:>14,.2f}\")\n        print(f\"  Faixa esperada ({COBERTURA}%)   : R$ {piso:>14,.2f}  a  R$ {teto:>12,.2f}\")\n        if preco_ofertado is not None:\n            print(f\"  Preço ofertado          : R$ {preco_ofertado:>14,.2f}\")\n            print(\"-\" * 62)\n            print(f\"  >> {decisao}\")\n            print(f\"     ({justificativa})\")\n        if alertas:\n            print(\"-\" * 62)\n            for a in alertas:\n                print(f\"  [!] Baixa confiança: {a}\")\n        print(\"=\" * 62)\n\n    return {\"estimado\": estimado, \"piso\": piso, \"teto\": teto,\n            \"decisao\": decisao, \"justificativa\": justificativa, \"alertas\": alertas}\n\n# Validação da calibração: quantos veículos do teste caem dentro da faixa prevista?\nlog_te = modelo_final.predict(X_te)\ndentro = ((y_te.values >= np.expm1(log_te + q05)) & (y_te.values <= np.expm1(log_te + q95))).mean()\nprint(f\"Cobertura nominal do intervalo : {COBERTURA}%\")\nprint(f\"Cobertura observada no teste   : {dentro*100:.1f}%\")\nprint(\"-> Próximo do nominal = intervalo bem calibrado e confiável para decisão.\")"
